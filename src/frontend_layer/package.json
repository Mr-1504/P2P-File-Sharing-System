{
  "name": "p2p-file-sharing",
  "version": "0.1.0",
  "description": "P2P File Sharing System",
  "author": {
    "name": "Minh",
    "email": "minh@example.com"
  },
  "main": "src/main/index.js",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "bootstrap": "^5.1.3",
    "framer-motion": "^12.23.12",
    "i18next": "^23.16.8",
    "lucide-react": "^0.546.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.5.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^25.9.8",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "wait-on": "^9.0.3"
  },
  "scripts": {
    "dev": "concurrently \"cross-env BROWSER=none react-scripts start\" \"npm run electron:wait\"",
    "electron:wait": "wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "react-build": "react-scripts build",
    "electron-build": "electron-builder",
    "dist": "npm run react-build && npm run electron-build"
  },
  "build": {
    "appId": "com.p2p.app",
    "productName": "P2PFileSharing",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/index.js"
    },
    "asarUnpack": [
      "src/main/preload.js",
      "build/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
